# Answers for unattended installs:  cp install.env.example install.env && chmod 600 install.env
#   sudo ./install.sh --config install.env [--yes]
# install.env is gitignored. Delete it after the install: the secrets live in Portainer from then on.
# Keys left out fall back to the interactive defaults. Secrets have no default and are required.

# Services live at <app>.DOMAIN (home.arpa = reserved for home networks)
DOMAIN=home.arpa
TZ=Europe/Amsterdam
PUID=1000
PGID=1000
CONFIG_ROOT=/opt/arr/config
DATA_ROOT=/srv/data

VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_SERVER_COUNTRIES=Netherlands
VPN_PORT_FORWARDING=off

# Optional Usenet stack (SABnzbd): yes only with a Usenet provider + NZB indexer
USENET=no

REPO_URL=https://github.com/<you>/arr-stack
REPO_REF=refs/heads/main
# Only for a private repo: fine-grained token, Contents read-only, this repo only
REPO_USERNAME=
REPO_TOKEN=

PORTAINER_USER=admin
PORTAINER_PASSWORD=
