# Portainer → Stacks → media → Environment variables. Enter these in the UI.
# Never commit real values. This file only documents the names.

DOMAIN=home.arpa
TZ=Europe/Amsterdam
# `id` on the host shows these. All linuxserver containers run as this user.
PUID=1000
PGID=1000
# Must match what scripts/init.sh created
CONFIG_ROOT=/opt/arr/config
# Downloads + media. MUST be one filesystem so hardlinks work.
DATA_ROOT=/srv/data

# VPN (Gluetun). Provider names: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=changeme
# The "Address" line from your provider's WireGuard config
WIREGUARD_ADDRESSES=10.2.0.2/32
VPN_SERVER_COUNTRIES=Netherlands
# on = provider-side port forwarding (ProtonVPN, PIA, ...)
VPN_PORT_FORWARDING=off
